[node name="Hall" type="Node2D"]
script = ExtResource("level")
level_key = "hall"
title = "The Weighing of the Heart"
intro_title = "Spell 125: The Hall of the Two Truths"
intro_body = "Explore the hall as it is drawn: Ma’at, the balance, the forty-two judges and Osiris in his shrine.\n\nWalk [b]right to left[/b] with [←] [→] or click the papyrus. Click a figure to walk up to it and read its description. Open the Journal with [j]."

