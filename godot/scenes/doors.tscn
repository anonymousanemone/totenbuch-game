[node name="Doors" type="Node2D"]
script = ExtResource("level")
level_key = "doors"
title = "Thoth Opens the Sky"
intro_title = "Spell 161: Thoth Opens the Doors of the Sky"
intro_body = "Explore the doors as they are drawn: four Thoths, in two rows, each at a door of the sky.\n\nWalk [b]right to left[/b] with [←] [→] or click the papyrus. Click a figure or its text to walk up to it and read about it. Open the Journal with [j]."

