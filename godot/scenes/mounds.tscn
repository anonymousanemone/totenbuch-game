[node name="Mounds" type="Node2D"]
script = ExtResource("level")
level_key = "mounds"
title = "The Fourteen Mounds"
intro_title = "Spell 149: The Fourteen Mounds"
intro_body = "Explore the mounds as they are drawn: fourteen in a row, each with its guardians.\n\nWalk [b]right to left[/b] with [←] [→] or click the papyrus. Click a figure to walk up to it and read its description. Open the Journal with [j]."

