level_key = "mouth"
title = "Mouth and Heart"
intro_title = "Spells 21–30: Mouth and Heart"
intro_body = "Explore the spells for the mouth and the heart as they are drawn.\n\nWalk [b]right to left[/b] with [←] [→] or click the papyrus. Click a figure or caption to walk up to it and read about it. Open the Journal with [j]."

